{
  "api_providers": {
    "type": "template_list",
    "description": "API 供应商配置",
    "hint": "Demo 只使用 micu_gpt_image2 供应商，模型固定为 gpt-image-2-pro",
    "templates": {
      "micu_gpt_image2": {
        "name": "米醋 gpt-image-2-pro",
        "hint": "用于最小 Demo 验证文生图、图生图和响应解析",
        "items": {
          "name": {
            "description": "适配器名称",
            "type": "string",
            "default": "micu_gpt_image2"
          },
          "base_url": {
            "description": "API Base URL",
            "type": "string",
            "default": ""
          },
          "proxy": {
            "description": "代理地址",
            "hint": "例如 http://127.0.0.1:7890；留空则不使用代理",
            "type": "string",
            "default": ""
          },
          "api_keys": {
            "description": "API Keys",
            "type": "list",
            "default": []
          },
          "max_reference_images": {
            "description": "最大参考图数量",
            "type": "int",
            "default": 1
          },
          "max_request_size_mb": {
            "description": "最大请求体大小 MB",
            "type": "int",
            "default": 20
          },
          "capability_options": {
            "description": "模型能力",
            "type": "list",
            "options": [
              "文生图",
              "图生图"
            ],
            "default": [
              "文生图",
              "图生图"
            ]
          }
        }
      }
    }
  },
  "balance_users": {
    "type": "template_list",
    "description": "用户余额管理",
    "hint": "配置允许使用生图的会话 UMO 与充值额度",
    "templates": {
      "user": {
        "name": "余额用户",
        "items": {
          "enabled": {
            "description": "启用用户",
            "type": "bool",
            "default": true
          },
          "umo": {
            "description": "用户 UMO",
            "type": "string",
            "default": ""
          },
          "balance_display": {
            "description": "用户余额",
            "type": "string",
            "default": "0",
            "hint": "展示用字段；运行时余额以插件数据文件为准"
          },
          "cost_per_image": {
            "description": "生图单次额度",
            "type": "float",
            "default": 0.1,
            "hint": "每生成 1 张图扣除的额度"
          },
          "add_amount": {
            "description": "添加金额",
            "type": "float",
            "default": 0
          }
        }
      }
    }
  }
}
