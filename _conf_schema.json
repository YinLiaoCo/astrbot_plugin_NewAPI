{
  "api_providers": {
    "type": "template_list",
    "description": "API 供应商配置",
    "hint": "配置生图接口分组。当前插件会按用户余额条目中选择的分组调用对应接口。",
    "templates": {
      "provider": {
        "name": "添加供应商",
        "hint": "每个条目的分组名称必须唯一",
        "items": {
          "name": {
            "description": "分组名称",
            "type": "string",
            "default": "API",
            "hint": "用户余额管理里的选择分组填写这个名称。重复名称会在插件运行时自动追加数字。"
          },
          "remark": {
            "description": "备注",
            "type": "string",
            "default": "用于最小 Demo 验证文生图、图生图和响应解析"
          },
          "base_url": {
            "description": "API Base URL",
            "type": "string",
            "default": "",
            "hint": "接口地址字段填写 /v1/... 路径时，会拼接到该 Base URL；填写完整 URL 时直接使用完整 URL。"
          },
          "text_to_image_enabled": {
            "description": "启用文生图",
            "type": "bool",
            "default": true
          },
          "text_to_image_endpoint": {
            "description": "文生图接口地址",
            "type": "string",
            "default": "/v1/images/generations",
            "hint": "仅在启用文生图时生效。"
          },
          "image_to_image_enabled": {
            "description": "启用图生图",
            "type": "bool",
            "default": true
          },
          "image_to_image_endpoint": {
            "description": "图生图接口地址",
            "type": "string",
            "default": "/v1/images/edits",
            "hint": "仅在启用图生图时生效，官方 gpt-image-2 单图和多图参考都使用 image[] 提交到该接口。"
          },
          "multi_reference_endpoint": {
            "description": "多参考图接口地址",
            "type": "string",
            "default": "/v1/images/edits",
            "hint": "兼容旧配置保留；官方 gpt-image-2 多参考图同样使用 /v1/images/edits。"
          },
          "proxy": {
            "description": "代理地址",
            "hint": "例如 http://127.0.0.1:7890；留空则不使用代理",
            "type": "string",
            "default": ""
          },
          "max_reference_images": {
            "description": "最大参考图数量",
            "type": "int",
            "default": 1
          },
          "max_request_size_mb": {
            "description": "最大请求体大小 MB",
            "type": "int",
            "default": 20
          }
        }
      }
    }
  },
  "balance_users": {
    "type": "template_list",
    "description": "用户余额管理",
    "hint": "配置允许使用生图的会话 UMO 与充值额度",
    "templates": {
      "user": {
        "name": "添加用户",
        "items": {
          "name": {
            "description": "用户名称",
            "type": "string",
            "default": "用户",
            "hint": "用于区分配置面板中的用户条目；重复名称会在插件运行时自动追加数字。"
          },
          "enabled_status_display": {
            "description": "条目状态",
            "type": "string",
            "default": "用户（启用）",
            "hint": "展示用字段；保存或插件同步后会按启用状态更新。"
          },
          "enabled": {
            "description": "启用用户",
            "type": "bool",
            "default": true
          },
          "umo": {
            "description": "用户 UMO",
            "type": "string",
            "default": ""
          },
          "provider_group": {
            "description": "选择分组",
            "type": "string",
            "default": "API",
            "hint": "填写 API 供应商配置中的分组名称。当前 AstrBot schema 不支持从另一个配置列表动态生成下拉选项。"
          },
          "api_key": {
            "description": "API Key",
            "type": "string",
            "default": "",
            "hint": "每个用户只能配置一条 API Key。"
          },
          "image_model": {
            "description": "生图模型",
            "type": "string",
            "default": "gpt-image-2",
            "hint": "填写 OpenAI 图像模型名称，例如 gpt-image-2"
          },
          "image_quality": {
            "description": "生图质量",
            "type": "string",
            "options": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "default": "auto"
          },
          "image_size": {
            "description": "图像分辨率",
            "type": "string",
            "default": "",
            "hint": "留空时使用命令里的比例和档位；也可填写 auto、1024x1024、1536x1024、1024x1536 等官方支持尺寸"
          },
          "balance_display": {
            "description": "用户余额",
            "type": "string",
            "default": "0",
            "hint": "展示用字段；运行时余额以插件数据文件为准"
          },
          "cost_per_image": {
            "description": "生图单次额度",
            "type": "float",
            "default": 0.1,
            "hint": "每生成 1 张图扣除的额度"
          },
          "add_amount": {
            "description": "添加金额",
            "type": "float",
            "default": 0
          }
        }
      }
    }
  }
}
